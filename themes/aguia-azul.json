{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg0": "#0B1020",
    "bg1": "#121831",
    "bg2": "#1A2240",
    "bg3": "#232C4E",
    "eagle": "#5E9CFF",
    "eagleSoft": "#7FB0FF",
    "amber": "#FFC46B",
    "amberSoft": "#FFD9A0",
    "red": "#FF6B6B",
    "orange": "#FFB86C",
    "green": "#7DDFA8",
    "cyan": "#6BE7E7",
    "purple": "#B48EAD",
    "text0": "#E6ECFF",
    "text1": "#C0C8E8",
    "text2": "#8A94B8",
    "text3": "#5E678C"
  },
  "theme": {
    "primary": { "dark": "eagle", "light": "eagle" },
    "secondary": { "dark": "eagleSoft", "light": "eagleSoft" },
    "accent": { "dark": "amber", "light": "amber" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "eagleSoft", "light": "eagle" },
    "text": { "dark": "text0", "light": "bg0" },
    "textMuted": { "dark": "text2", "light": "text3" },
    "background": { "dark": "bg0", "light": "#F4F6FF" },
    "backgroundPanel": { "dark": "bg1", "light": "#E8ECFB" },
    "backgroundElement": { "dark": "bg2", "light": "#DCE2F7" },
    "border": { "dark": "bg3", "light": "#AAB4DA" },
    "borderActive": { "dark": "eagle", "light": "eagle" },
    "borderSubtle": { "dark": "bg3", "light": "#C2CAE8" },
    "diffAdded": { "dark": "green", "light": "#2E9E63" },
    "diffRemoved": { "dark": "red", "light": "#D64646" },
    "diffContext": { "dark": "text2", "light": "text2" },
    "diffHunkHeader": { "dark": "text2", "light": "text2" },
    "diffHighlightAdded": { "dark": "green", "light": "#2E9E63" },
    "diffHighlightRemoved": { "dark": "red", "light": "#D64646" },
    "diffAddedBg": { "dark": "bg2", "light": "#E3F3EA" },
    "diffRemovedBg": { "dark": "bg2", "light": "#F9E3E3" },
    "diffContextBg": { "dark": "bg1", "light": "#EFF2FC" },
    "diffLineNumber": { "dark": "text3", "light": "text3" },
    "diffAddedLineNumberBg": { "dark": "bg2", "light": "#E3F3EA" },
    "diffRemovedLineNumberBg": { "dark": "bg2", "light": "#F9E3E3" },
    "markdownText": { "dark": "text0", "light": "bg0" },
    "markdownHeading": { "dark": "eagleSoft", "light": "eagle" },
    "markdownLink": { "dark": "eagleSoft", "light": "eagle" },
    "markdownLinkText": { "dark": "amber", "light": "#B0762A" },
    "markdownCode": { "dark": "amberSoft", "light": "#B0762A" },
    "markdownBlockQuote": { "dark": "text2", "light": "text2" },
    "markdownEmph": { "dark": "purple", "light": "#8B6D8B" },
    "markdownStrong": { "dark": "amber", "light": "#B0762A" },
    "markdownHorizontalRule": { "dark": "bg3", "light": "#C2CAE8" },
    "markdownListItem": { "dark": "eagleSoft", "light": "eagle" },
    "markdownListEnumeration": { "dark": "amber", "light": "#B0762A" },
    "markdownImage": { "dark": "eagleSoft", "light": "eagle" },
    "markdownImageText": { "dark": "text2", "light": "text3" },
    "markdownCodeBlock": { "dark": "text0", "light": "bg0" },
    "syntaxComment": { "dark": "text3", "light": "text3" },
    "syntaxKeyword": { "dark": "purple", "light": "#8B6D8B" },
    "syntaxFunction": { "dark": "eagleSoft", "light": "eagle" },
    "syntaxVariable": { "dark": "cyan", "light": "#1F8A8A" },
    "syntaxString": { "dark": "green", "light": "#2E9E63" },
    "syntaxNumber": { "dark": "amber", "light": "#B0762A" },
    "syntaxType": { "dark": "cyan", "light": "#1F8A8A" },
    "syntaxOperator": { "dark": "purple", "light": "#8B6D8B" },
    "syntaxPunctuation": { "dark": "text1", "light": "text3" }
  }
}
