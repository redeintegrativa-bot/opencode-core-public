{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "aguia-azul",
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto",
  "mouse": true,
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.3,
    "sound_pack": "opencode.default"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "command_list": "ctrl+p",
    "theme_list": "<leader>t",
    "session_new": "<leader>n",
    "session_list": "<leader>l",
    "messages_copy": ["<leader>y", "ctrl+shift+c"]
  }
}
