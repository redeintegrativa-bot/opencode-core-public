{
  "$schema": "https://opencode.ai/config.json",
  "name": "opencode-core-public",
  "version": "1.3.0",
  "description": "OpenCode Core by Rede Integrativa — 56 agents, 37 skills, canivete suíço",
  "agents": {"source": "../agents"},
  "skills": {
    "source": "../skills",
    "registry": "../skills/registry.json"
  },
  "rules": {"source": "../rules"},
  "hooks": {
    "validate_security": {
      "command": "python3 ../hooks/validate_security.py .",
      "type": "pre-commit"
    }
  },
  "permissions": {
    "allow": ["bash", "read", "write", "edit", "glob", "grep", "web", "task"],
    "deny": []
  },
  "plugins": {
    "providers": {
      "description": "DeFi/Crypto data providers",
      "source": "../providers"
    },
    "memory": {
      "description": "Memory persistence layer",
      "source": "../memory"
    },
    "services": {
      "description": "Shared services (scoring, learning, ranking)",
      "source": "../services"
    }
  }
}

